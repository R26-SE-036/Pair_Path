# Reference, not a replacement.
#
# If you already have a .env, compare and add only what you are missing - your
# .env holds credentials that exist nowhere else. Copy this over it only if you
# have no .env at all.

# ── Databases ──
# Required. Used by the app and by `prisma migrate`.
DATABASE_URL=postgresql://user:password@localhost:5432/pair_path

# Optional, for a pooler (Neon). Runtime queries go through it when set.
# Migrations always use DATABASE_URL: a transaction-mode pooler cannot hold the
# session-level advisory locks Prisma Migrate needs.
# DATABASE_URL_POOLED=

# ── Auth ──
# REQUIRED, no default, and the API refuses to start without it. PairPath signs
# its own tokens even when the identity came from Code Coach, because every
# foreign key here points at the local users.id and the Socket.IO handshake
# verifies this signature. The old fallback was a literal committed to this
# repository, which let anyone mint a token for any user.
JWT_SECRET=change-me

# ── Code Coach: the Code Guru identity provider ──
# Required for POST /auth/exchange (single sign-on). Empty disables it and
# PairPath uses local auth only.
CODE_COACH_URL=http://127.0.0.1:8000
CODE_COACH_CLIENT_NAME=pair-review-studio
CODE_COACH_TIMEOUT_MS=8000

# ── Services ──
# REQUIRED, no default. A local address on port 8000 is rejected, because that
# is Code Coach: the old default sent PairPath's feature vectors to the identity
# provider and then used a hardcoded PRODUCTIVE reply when the response did not
# parse, so the classifier was silently not running.
ML_SERVICE_URL=http://127.0.0.1:8020
PORT=3001

# Optional, and the same value on both sides. The ML service has no users and
# no authentication of its own - it is called by this API, server to server -
# so where the two run on a shared network this is what stops anything else on
# that network asking it for predictions. Unset, the ML service warns at
# startup and accepts anyone who can reach the port.
# ML_SERVICE_TOKEN=

# Comma-separated browser origins allowed to call this API and open a socket.
# CORS_ORIGINS is the name Study Guider and the gamification engine use;
# FRONTEND_URL is still read as a fallback for older .env files.
CORS_ORIGINS=http://localhost:4200

# Warned about at startup when unset, and genuinely required behind more than
# one instance: intervention cooldowns fall back to a per-process map, so each
# instance keeps its own and a student receives the same nudge once per
# instance.
REDIS_URL=redis://localhost:6379

# ── The review after a session ──
# Written by a language model PairPath calls itself. Gemini is asked first
# unless LLM_PROVIDER=openai; when the first cannot answer and the other has a
# key, the other is asked. With neither key every review is the exercise's
# fixed questions - a working review, just not a written one.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=low

# Shared with Code Coach, the same value in both. A free-coding session has no
# exercise, so its hints and its suggested next exercise come from asking Code
# Coach which concepts the pair's code touches (POST /api/v1/internal/concepts).
# Unset, hints fall back to general teamwork guidance.
# INTERNAL_SERVICE_KEY=

# ── Code execution ──
# Set this and student code runs in the code-runner Lambda; leave it unset and
# the API falls back to `docker run`. Lambda wins whenever it is set, so a
# deployed environment that happens to have a Docker socket cannot silently
# prefer it. See ../code-runner-lambda/.
# CODE_RUNNER_LAMBDA_FUNCTION=codeguru-code-runner

# Local escape hatch for a machine with no Docker. Student code then runs with
# the API's own permissions, including read access to this file. Never set it
# anywhere real participants can reach.
# CODE_RUNNER_ALLOW_UNSANDBOXED=true
