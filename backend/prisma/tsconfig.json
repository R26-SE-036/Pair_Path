{
  // One-off scripts in this folder run outside the app's source root, so
  // compiling them alone makes ./prisma the inferred common source directory
  // and TypeScript refuses to emit (TS5011). Pinning rootDir to the package
  // root fixes that without touching the app's own build.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true
  },
  "include": ["./**/*.ts"],
  // `exclude` has to be restated, not inherited. The parent config excludes
  // "prisma" so that the app's build stops inferring its source root from
  // these files - and an inherited exclude would leave this config excluding
  // the very files it includes (TS18003: no inputs were found).
  "exclude": ["../node_modules", "../dist"]
}
