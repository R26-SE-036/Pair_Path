# npm ignores the `engines` field unless told not to. Without this, running
# `npm install` on a machine with a newer Node rewrites package-lock.json in a
# format node:22-alpine's npm 10 cannot read, and the Docker build then fails
# with `Missing: chokidar@4.0.3 from lock file` while the same lock installs
# fine on the host. That happened twice before this line existed.
engine-strict=true
