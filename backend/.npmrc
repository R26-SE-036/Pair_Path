# npm ignores the `engines` field unless told not to. Without this, running
# `npm install` on a machine with a newer Node rewrites package-lock.json in a
# format node:22-alpine's npm 10 cannot read, and the Docker build then fails
# with `Missing: chokidar@4.0.3 from lock file` while the same lock installs
# fine on the host. That happened twice before this line existed.
engine-strict=true

# If you need to change dependencies, regenerate the lock with the pinned Node
# rather than the one you happen to have installed:
#
#     npm run lock
#
# which runs `npm install --package-lock-only` inside node:22-alpine. Doing it
# on Node 25 produces a lock that npm 10 rejects - it omits six nested entries
# (chokidar and readdirp under the Nest and Angular schematics packages) that
# npm 10 expects, and the Docker build then fails with:
#
#     npm error Missing: chokidar@4.0.3 from lock file
#
# Diffing the two locks by top-level package shows no difference at all, which
# is how this gets missed: the entries that matter are nested.
