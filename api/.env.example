# ============================================================================
# REFERENCE, NOT A REPLACEMENT.
#
# This file lists every setting this service understands - the ones it always
# had, plus the ones added for Code Guru integration.
#
# If you ALREADY have a .env, do not copy this over it: your .env holds real
# credentials that exist nowhere else. Compare the two and add only the keys
# you are missing. Copy the whole file only if you have no .env at all.
# ============================================================================

# ── Databases ──
# Required. Used by the app AND by `prisma migrate`.
DATABASE_URL=postgresql://user:password@localhost:5432/pairpath

# OPTIONAL. Only if you are on Neon (or any pooler). When set, runtime queries
# go through it; when absent, everything uses DATABASE_URL exactly as before.
# Migrations always use DATABASE_URL - a transaction-mode pooler cannot hold the
# advisory locks Prisma Migrate needs.
# DATABASE_URL_POOLED=
# MONGODB_URI is gone. The analytics trail it held duplicated PostgreSQL: of
# MongoDbService's eleven methods only two were ever called, both write-only,
# and nothing read any of it back. The one thing that was NOT duplicated - the
# feature/prediction pairs kept for later human labeling - now goes to
# feature_windows and pair_state_predictions, two tables that were in the
# Prisma schema from the start and that nothing had ever written to.

# REQUIRED behind more than one API instance, and warned about at startup when
# unset. Intervention cooldowns are SETEX-based; without Redis they fall back
# to a per-process Map, so each instance keeps its own and a student receives
# the same nudge once per instance.
REDIS_URL=redis://localhost:6379

# ── PairPath's own JWT ──
# Signs the tokens the frontend and the Socket.IO gateway use. Not shared with
# Code Coach: PairPath issues its own token even when the identity came from
# there, because every foreign key in this schema points at the local users.id.
# REQUIRED. There is no default and the API refuses to start without it.
# It used to fall back to the literal 'pair-programming-secret' in four
# separate files, and that literal is committed to this repository - so an
# unset variable meant anyone could mint a token for any user id, and the
# Socket.IO handshake would accept it. Nothing in the boot output
# distinguished that from a correct setup.
JWT_SECRET=change-me

# ── Code Coach (the Code Guru platform identity provider) ──
# Required for POST /auth/exchange, which trades a Code Coach access token for
# a PairPath one. Without it, single sign-on from the portal cannot work and
# the endpoint returns 503.
CODE_COACH_URL=http://127.0.0.1:8000
CODE_COACH_CLIENT_NAME=pair-review-studio
CODE_COACH_TIMEOUT_MS=8000

# ── Services ──
# Browser origins allowed to call this API and open a socket to it.
# Comma-separated - the unified app on 4200 and the old frontend on 3000 can
# both be allowed at once. This used to be a single value, so running both
# meant editing this file and restarting to switch between them.
#
# CORS_ORIGINS is the name Study Guider and the gamification engine use.
# FRONTEND_URL is still read as a fallback so existing .env files keep working.
CORS_ORIGINS=http://localhost:4200,http://localhost:3000
# REQUIRED. No default, and anything on port 8000 is rejected because that
# is Code Coach. The old default WAS http://localhost:8000, so an unset
# variable posted PairPath's feature vectors at the platform's identity
# provider and then silently used a hardcoded PRODUCTIVE prediction when the
# reply did not parse - the collaboration classifier was not running.
ML_SERVICE_URL=http://127.0.0.1:8020
PORT=3001

# ── Code execution ──
# Set this and student code runs in the code-runner Lambda; leave it unset and
# the API falls back to `docker run` locally. Lambda wins whenever it is set,
# so a deployed environment that happens to have a Docker socket cannot
# silently prefer it. See ../code-runner-lambda/.
# CODE_RUNNER_LAMBDA_FUNCTION=codeguru-code-runner

# Local development escape hatch, for a machine with no Docker. Student code
# then runs with the API's own permissions - including read access to this
# file. Never set it anywhere real participants can reach.
# CODE_RUNNER_ALLOW_UNSANDBOXED=true
