# ============================================================================
# REFERENCE, NOT A REPLACEMENT.
#
# This file lists every setting this service understands - the ones it always
# had, plus the ones added for Code Guru integration.
#
# If you ALREADY have a .env, do not copy this over it: your .env holds real
# credentials that exist nowhere else. Compare the two and add only the keys
# you are missing. Copy the whole file only if you have no .env at all.
# ============================================================================

# ── Databases ──
# Required. Used by the app AND by `prisma migrate`.
DATABASE_URL=postgresql://user:password@localhost:5432/pairpath

# OPTIONAL. Only if you are on Neon (or any pooler). When set, runtime queries
# go through it; when absent, everything uses DATABASE_URL exactly as before.
# Migrations always use DATABASE_URL - a transaction-mode pooler cannot hold the
# advisory locks Prisma Migrate needs.
# DATABASE_URL_POOLED=
MONGODB_URI=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379

# ── PairPath's own JWT ──
# Signs the tokens the frontend and the Socket.IO gateway use. Not shared with
# Code Coach: PairPath issues its own token even when the identity came from
# there, because every foreign key in this schema points at the local users.id.
JWT_SECRET=change-me

# ── Code Coach (the Code Guru platform identity provider) ──
# Required for POST /auth/exchange, which trades a Code Coach access token for
# a PairPath one. Without it, single sign-on from the portal cannot work and
# the endpoint returns 503.
CODE_COACH_URL=http://127.0.0.1:8000
CODE_COACH_CLIENT_NAME=pair-review-studio
CODE_COACH_TIMEOUT_MS=8000

# ── Services ──
FRONTEND_URL=http://localhost:3000
ML_SERVICE_URL=http://127.0.0.1:8020
PORT=3001
