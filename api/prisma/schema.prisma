// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessionMemberships PairSessionMember[]
  sessionEvents      SessionEvent[]
  reviewSubmissions  ReviewSubmission[]

  @@map("users")
}

model Topic {
  id          String @id @default(cuid())
  name        String @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  questions Question[]

  @@map("topics")
}

model Question {
  id                String @id @default(cuid())
  topicId           String
  title             String
  description       String
  difficulty        String
  starterCode       String   @default("")
  referenceSolution String
  reviewQuestions   Json   // Array of review questions
  conceptTags       Json   // Array of concept tags
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  topic   Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sessions PairSession[]

  @@map("questions")
}

model PairSession {
  id           String    @id @default(cuid())
  joinCode     String    @unique
  questionId   String
  status       String    @default("ACTIVE") // ACTIVE, COMPLETED
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  finalCode    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  question    Question            @relation(fields: [questionId], references: [id])
  members     PairSessionMember[]
  events      SessionEvent[]
  snapshots   CodeSnapshot[]
  windows     FeatureWindow[]
  predictions PairStatePrediction[]
  interventions Intervention[]
  reviews     ReviewSubmission[]

  @@map("pair_sessions")
}

model PairSessionMember {
  id       String @id @default(cuid())
  sessionId String
  userId    String
  role      String // DRIVER, NAVIGATOR
  joinedAt  DateTime @default(now())

  // Relations
  session PairSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("pair_session_members")
}

model SessionEvent {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  role      String
  eventType String // CODE_EDIT, CODE_DELETE, RUN_ATTEMPT, RUN_SUCCESS, RUN_FAILURE, ROLE_SWITCH, DISCUSSION_NOTE, IDLE_PERIOD
  timestamp DateTime @default(now())
  metadata  Json     // Event-specific data

  // Relations
  session PairSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session_events")
}

model CodeSnapshot {
  id        String   @id @default(cuid())
  sessionId String
  code      String
  timestamp DateTime @default(now())

  // Relations
  session PairSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("code_snapshots")
}

model FeatureWindow {
  id          String   @id @default(cuid())
  sessionId   String
  windowStart DateTime
  windowEnd   DateTime
  features    Json     // Extracted features
  createdAt   DateTime @default(now())

  // Relations
  session PairSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("feature_windows")
}

model PairStatePrediction {
  id           String   @id @default(cuid())
  sessionId    String
  windowStart  DateTime
  windowEnd    DateTime
  predictedState String
  confidence   Float
  modelVersion String
  createdAt    DateTime @default(now())

  // Relations
  session PairSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("pair_state_predictions")
}

model Intervention {
  id        String   @id @default(cuid())
  sessionId String
  state     String
  action    String
  uiTarget  String
  uiEffect  String
  message   String
  shownAt   DateTime @default(now())
  accepted  Boolean?
  createdAt DateTime @default(now())

  // Relations
  session PairSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("interventions")
}

model ReviewSubmission {
  id         String   @id @default(cuid())
  sessionId  String
  userId     String
  answers    Json     // Array of True/False answers
  score      Int
  completedAt DateTime @default(now())

  // Relations
  session PairSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("review_submissions")
}

model RAGDocument {
  id          String   @id @default(cuid())
  title       String
  content     String
  source      String
  conceptTags Json     // Array of concept tags
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  chunks RAGChunk[]

  @@map("rag_documents")
}

model RAGChunk {
  id           String   @id @default(cuid())
  documentId   String
  chunkText    String
  conceptTag   String
  embedding    Json?    // Vector embedding
  createdAt    DateTime @default(now())

  // Relations
  document RAGDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("rag_chunks")
}

// ─────────────────────────────────────────────────────────────────────────
// SIMULATED TRAINING CORPUS
//
// The 200-session dataset the current demo model was trained on, loaded from
// ml-service/data/ so it can be browsed and demonstrated rather than living
// only as CSV and JSON files.
//
// Kept separate from PairSession / SessionEvent on purpose: those hold real
// recorded behaviour and are the source of truth for the research, so mixing
// 14,771 generated events into them would make every future export a silent
// blend of real and simulated data. Every row here comes from
// dev_tools/generate_demo_sessions.py and is not student data.
// ─────────────────────────────────────────────────────────────────────────

model SimulatedSession {
  id          String   @id // e.g. "demo_productive_00" — self-identifying
  label       String   // the collaboration state this session was generated to represent
  labelSource String   @default("simulated")
  rater       String   @default("generator")
  createdAt   DateTime @default(now())

  events  SimulatedEvent[]
  windows SimulatedWindow[]

  @@index([label])
  @@map("simulated_sessions")
}

model SimulatedEvent {
  id        String   @id @default(cuid())
  sessionId String
  userId    String // "U1" / "U2" — generated participants, not real users
  eventType String
  timestamp DateTime
  metadata  Json

  session SimulatedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
  @@index([eventType])
  @@map("simulated_events")
}

// One row per sliding window: the 15 feature values the model actually sees,
// plus the label. This is literally the training set, row for row.
model SimulatedWindow {
  id          String   @id @default(cuid())
  sessionId   String
  windowStart Float // epoch seconds
  windowEnd   Float
  features    Json // the 15 canonical features
  label       String
  labelSource String   @default("simulated")
  rater       String   @default("generator")
  createdAt   DateTime @default(now())

  session SimulatedSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([label])
  @@map("simulated_windows")
}
