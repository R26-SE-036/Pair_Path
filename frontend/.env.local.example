# Code Coach — the Code Guru platform's identity provider.
NEXT_PUBLIC_CODE_COACH_URL=http://127.0.0.1:8000

# The shared Code Guru portal. A student with no session is sent here to sign
# in and comes back with the session in the URL fragment.
NEXT_PUBLIC_PORTAL_URL=http://localhost:4200

# Renders the localhost-only login/register forms instead of redirecting to the
# portal, so PairPath can be developed on its own. Ignored unless the page is
# served from localhost. Leave unset in any deployed build.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true
